{
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Skill(superpowers:brainstorming)",
      "Skill(superpowers:test-driven-development)",
      "WebFetch(domain:api.github.com)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(find * | head *)",
      "Bash(find * | grep *)",
      "Bash(ls -la *)",
      "Bash(ls -a *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(tree *)",
      "Bash(wc *)",
      "Bash(awk *)",
      "Bash(mkdir *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git log *)",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(python3 *)",
      "Bash(terraform *)",
      "Bash(terraform fmt *)",
      "Bash(tflint *)",
      "Bash(checkov *)",
      "Bash(infracost breakdown *)",
      "Bash(act *)",
      "Bash(cd * && *)",
      "Bash(git check-ignore *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(sudo *)",
      "Bash(* --force)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nico/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Grep tool call: $ARGUMENTS\n\nIs the pattern field searching for a Python/code symbol name (class name, function name, method name, or type name as a standalone identifier)? Examples that ARE symbol searches: AgentResult, BaseAgent, \"class Coordinator\", \"def handle_message\", DiscoveryAgent. Examples that are NOT (grep is fine): depends_on, oracle, assessment, regex with special chars, natural language strings, SQL text, comment text.\n\nIf it IS a symbol search, output ONLY:\n{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"additionalContext\": \"LSP reminder: this looks like a symbol search. Use workspaceSymbol / goToDefinition / findReferences / documentSymbol instead of Grep per CLAUDE.md.\"}}\n\nIf grep is appropriate, output ONLY: {}",
            "statusMessage": "Checking if LSP should be used..."
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/protect-secrets.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/python-format.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"$\\(.cost.total_cost_usd // 0 | . * 100 | floor / 100)                                          \\(((.context_window.current_usage.input_tokens // 0) * 100 / (.context_window.context_window_size // 200000)) | floor)%\"'"
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": false,
    "swift-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "playground@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "memsearch@memsearch-plugins": true,
    "code-simplifier@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "memsearch-plugins": {
      "source": {
        "source": "github",
        "repo": "zilliztech/memsearch"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "promptSuggestionEnabled": false,
  "autoUpdatesChannel": "latest"
}
